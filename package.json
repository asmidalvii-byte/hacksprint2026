{
  "name": "dukaanscan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:live": "node scripts/test-live.js",
    "models": "node scripts/list-models.js",
    "build:landing": "tailwindcss -i styles/landing.css -o public/landing/landing.css --minify && esbuild landing/main.tsx --bundle --minify --format=esm --target=es2022 --outfile=public/landing/landing.js",
    "typecheck:landing": "tsc -p tsconfig.landing.json"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@supabase/supabase-js": "2.118.0",
    "ajv": "8.20.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "file-type": "22.2.0",
    "multer": "2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "^7.0.2"
  }
}
