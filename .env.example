# Copy to .env. Never commit credentials. Restart the server after editing.
AI_ENABLED=false
GEMINI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
# Only for GEMINI_PROVIDER=api-key; enter locally, never in chat or browser code.
GEMINI_API_KEY=
# Sarvam text-to-speech (https://api.sarvam.ai/text-to-speech). Leave blank to keep
# the device-only voice preview; setting a key enables real Sarvam audio generation.
SARVAM_API_KEY=
# bulbul:v2, bulbul:v3 (default) or bulbul:v4-flash. Leave blank to use bulbul:v3.
SARVAM_MODEL=
AI_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760
HOST=127.0.0.1
PORT=3000

# Reserved setup inventory only: these do NOT enable publishing/storage adapters.
# Configure only after authorized setup; see docs/FINAL-MILESTONES.md.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=
META_APP_ID=
META_APP_SECRET=
GCS_BUCKET=
BIGQUERY_DATASET=
BIGQUERY_TABLE=
BIGQUERY_LOCATION=
# Prefer authorized ADC; never put service-account JSON inside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/credentials.json

# Seller accounts: public publishable key only; never service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Sandbox.co.in GST test API only. Never put these keys in frontend code.
GST_SANDBOX_ENABLED=false
GST_SANDBOX_API_KEY=
GST_SANDBOX_API_SECRET=
# Provider-issued test GSTIN for the live test script (not a real seller approval).
GST_SANDBOX_TEST_GSTIN=

# Explicit local demo access, disabled in production/non-loopback deployments.
# Uses confirmed Supabase emails matching the two local test account variables.
KRITI_TEST_ACCOUNT_ACCESS=false
TEST_SELLER_A_EMAIL=
TEST_SELLER_B_EMAIL=
